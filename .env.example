# Copier ce fichier en .env.local (ou .env) et remplir les valeurs.
# Sur Vercel : Settings > Environment Variables.

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire.
# Sans domaine vérifié chez Resend, ce doit être l'email du compte Resend.
CONTACT_TO_EMAIL=

# Expéditeur (optionnel). Par défaut : Portfolio <onboarding@resend.dev>
# Avec un domaine vérifié : Portfolio <contact@tondomaine.fr>
# CONTACT_FROM_EMAIL=
